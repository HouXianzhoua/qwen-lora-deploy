# .env.example
# 请复制此文件为 .env 并根据需要修改

# 模型路径（挂载路径）
MODEL_PATH=/mnt/models/Qwen2-0.5B-Instruct

# LoRA 权重路径（容器内路径）
LORA_PATH=/app/finetune/output/final_model

# 服务端口
API_PORT=8000

# 推理参数默认值
DEFAULT_MAX_NEW_TOKENS=128
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9

# Gunicorn worker 数量
WORKERS=1

# 是否开启调试模式
DEBUG=false

# 线程池大小
MAX_WORKERS_THREAD_POOL=2

# 批量推理参数
BATCH_MAX_SIZE=32
BATCH_INTERVAL_MS=40
